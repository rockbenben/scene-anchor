autoload -Uz log_error log_status log_info mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  # Ubuntu 26.04 resolves packages against amd64v3 while the OBS PPA only
  # publishes binary-amd64; apt therefore ignores the PPA and falls back to
  # the archive's OBS 32.1. Download the pinned PPA package explicitly.
  local ubuntu_codename obs_version obs_packages obs_filename obs_url obs_deb
  ubuntu_codename="$(awk -F= '/^VERSION_CODENAME=/{gsub(/"/, "", $2); print $2}' /etc/os-release)"
  obs_version="$(jq -r '.dependencies["obs-studio"].version' ${project_root}/buildspec.json)"
  obs_packages="$(mktemp)"
  obs_deb="$(mktemp --suffix=.deb)"
  curl -fsSL \
    "https://ppa.launchpadcontent.net/obsproject/obs-studio/ubuntu/dists/${ubuntu_codename}/main/binary-amd64/Packages.gz" \
    | gzip -dc > ${obs_packages}
  obs_filename="$(awk -v version="${obs_version}" '
    /^Package:/ { pkg = ($2 == "obs-studio") }
    pkg && /^Version:/ { ver = $2 }
    pkg && /^Filename:/ { if (ver == version || index(ver, version "-") == 1) { print $2; exit } }
  ' ${obs_packages})"
  if [[ -z ${obs_filename} ]]; then
    log_error "OBS ${obs_version} not found in the OBS PPA Packages index"
    return 2
  fi
  obs_url="https://ppa.launchpadcontent.net/obsproject/obs-studio/ubuntu/${obs_filename}"
  curl -fsSL "${obs_url}" -o ${obs_deb}

  sudo apt update
  sudo apt-get install ${apt_args} \
    build-essential \
    libgles2-mesa-dev \
    libsimde-dev \
    ${obs_deb}
  rm -f ${obs_packages} ${obs_deb}

  local -a _qt_packages=()

  if (( QT_VERSION == 5 )) {
    _qt_packages+=(
      qtbase5-dev${suffix}
      libqt5svg5-dev${suffix}
      qtbase5-private-dev${suffix}
      libqt5x11extras5-dev${suffix}
    )
  } else {
    _qt_packages+=(
      qt6-base-dev${suffix}
      libqt6svg6-dev${suffix}
      qt6-base-private-dev${suffix}
    )
  }

  sudo apt-get install ${apt_args} ${_qt_packages}
  log_group
}
